# Copie este archivo como .streamlit/secrets.toml (uso local) o pegue su contenido en
# Streamlit Cloud > App > Settings > Secrets. NUNCA suba el secrets.toml real a GitHub.

# Base de datos (Supabase > Project Settings > Database > Connection string > "Session pooler" > URI).
# Sin esta línea, la app guarda en CSV locales (data/registros/).
database_url = "postgresql://postgres.xxxxxxxx:SU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Código que se entrega a los participantes (sin esta línea, la app queda abierta).
codigo_acceso = "cambie-este-codigo"

# Código solo para ustedes: permite ver el historial de predicciones y los resultados del SUS.
codigo_admin = "cambie-este-otro-codigo"

# Aviso opcional que se muestra en el inicio y en el formulario.
aviso = "Evaluación de usabilidad: use solo casos simulados. No ingrese datos reales ni identificables de pacientes."
